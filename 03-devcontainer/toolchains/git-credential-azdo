#!/bin/bash
# Git credential helper for Azure DevOps: hands Git a short-lived Microsoft Entra
# access token from the Azure CLI. No PAT, nothing stored on disk by this helper.
#
# Git calls it as:  git-credential-azdo get   (with the request on stdin)
# Install: copy to /usr/local/bin/ and run, once per image:
#   git config --system credential.https://dev.azure.com.helper /usr/local/bin/git-credential-azdo
set -uo pipefail

# Azure DevOps' well-known application ID: the token "audience" for Azure DevOps
AZDO_RESOURCE=499b84ac-1321-427f-aa17-267ca6975798

# Only answer "get"; ignore "store" and "erase": there is nothing to store.
[ "${1:-}" = "get" ] || exit 0

host=""
while IFS='=' read -r key value; do
    [ -z "$key" ] && break
    [ "$key" = "host" ] && host="$value"
done

case "$host" in
    dev.azure.com|*.visualstudio.com) ;;
    *) exit 0 ;;                       # not Azure DevOps: let other helpers answer
esac

token=$(az account get-access-token --resource "$AZDO_RESOURCE" --query accessToken --output tsv 2>/dev/null) || {
    echo "git-credential-azdo: no Azure sign-in. Run: az login --use-device-code" >&2
    exit 0
}
[ -n "$token" ] || exit 0

echo "username=azure-devops"
echo "password=$token"
